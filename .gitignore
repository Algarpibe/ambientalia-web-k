# Dependencies
node_modules/

# Corpus: la CAPTURA se commitea (línea base); lo transformado se DERIVA de
# captura + código (T1-T8 re-ejecutables) y no se versiona.
corpus/transformado/
.pnp
.pnp.js

# Build
.next/
out/
build/
dist/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

