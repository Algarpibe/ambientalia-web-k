{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // F2-3: `@kunak/cms-config` es TypeScript sin compilar y sus importaciones
    // internas llevan la extensión `.ts` (igual que en `apps/cms`, que ya lo
    // declara). Sin esto el typecheck de la app de render muere DENTRO del
    // paquete compartido, no en su propio código.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-nuevo/types/**/*.ts",
    ".next-nuevo/dev/types/**/*.ts",
    ".next-p1/types/**/*.ts",
    ".next-p1/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
