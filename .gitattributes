# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Shell scripts must always use LF, even on Windows
*.sh text eol=lf

# Batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
# La captura del corpus es BYTES del original: sin conversion de fin de linea,
# o el sha256 del INDICE deja de casar en el siguiente checkout.
corpus/** -text
